; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Peraviz"
run/main_scene="res://startup_splash.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/icons/app/peraviz_app_512.png"
config/windows_native_icon="res://assets/icons/app/peraviz_app.ico"
boot_splash/image="res://assets/peraviz_splash.png"
boot_splash/bg_color=Color(0.055, 0.055, 0.065, 1)
boot_splash/show_image=false

[display]

window/size/mode=0
window/size/viewport_width=1366
window/size/viewport_height=768
window/size/window_width_override=1366
window/size/window_width_override.template=222
window/size/window_height_override=768
window/size/window_height_override.template=268
window/size/initial_position_type=1
window/size/borderless=true
window/size/always_on_top=true
window/size/resizable=false
window/size/transparent=false
window/per_pixel_transparency/allowed=false

[editor]


[peraviz]

peraviz_debug_baseline=false

[physics]

3d/physics_engine="Jolt Physics"
jolt_physics_3d/limits/max_bodies=65536

[rendering]

renderer/rendering_method="forward_plus"
rendering_device/driver.windows="vulkan"
viewport/transparent_background=false
anti_aliasing/quality/screen_space_aa=2
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/use_taa=false
anti_aliasing/quality/use_debanding=false
scaling_3d/scale=1.0
scaling_3d/mode=0
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/16_bits=true


[shader_globals]

peraviz_fake_smoke_enabled={
"type": "bool",
"value": false
}
peraviz_fake_smoke_shape={
"type": "vec3",
"value": Vector3(1, 0.35, 0.0833333)
}
peraviz_fake_smoke_velocity={
"type": "vec3",
"value": Vector3(0.098298, 0.03, 0.068829)
}
peraviz_fake_smoke_noise={
"type": "sampler3D",
"value": ""
}
