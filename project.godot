; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Peraviz"
run/main_scene="res://startup_splash.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 0)
boot_splash/show_image=false
boot_splash/image="res://assets/peraviz_splash.png"
config/icon="res://assets/peraviz_icon_512.png"
config/windows_native_icon="res://assets/peraviz.ico"

[display]

window/size/viewport_width=1366
window/size/viewport_height=768
window/size/resizable=false
window/size/borderless=true
window/size/always_on_top=true
window/size/transparent=true
window/size/window_width_override=222
window/size/window_height_override=268
window/per_pixel_transparency/allowed=true

[peraviz]

peraviz_debug_baseline=false

[physics]

3d/physics_engine="Jolt Physics"
jolt_physics_3d/limits/max_bodies=65536

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
viewport/transparent_background=true
anti_aliasing/quality/screen_space_aa=2

[shader_globals]

peraviz_fake_smoke_enabled={
"type": "bool",
"value": false
}
peraviz_fake_smoke_shape={
"type": "vec3",
"value": Vector3(1, 0.35, 0.0833333)
}
peraviz_fake_smoke_velocity={
"type": "vec3",
"value": Vector3(0.098298, 0.03, 0.068829)
}
peraviz_fake_smoke_noise={
"type": "sampler3D",
"value": ""
}
